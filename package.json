{
  "name": "mind-md",
  "displayName": "mind.md",
  "description": "Edit the headings of a Markdown file as a mind map, without touching the rest of your text.",
  "version": "0.1.2",
  "publisher": "pandawidkur",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pandawidkur/mindmap-vsc.git"
  },
  "bugs": {
    "url": "https://github.com/pandawidkur/mindmap-vsc/issues"
  },
  "homepage": "https://github.com/pandawidkur/mindmap-vsc#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mindmap",
    "mind map",
    "outline",
    "headings",
    "editor"
  ],
  "activationEvents": [
    "onCommand:mindmap.openSplit",
    "onCustomEditor:mindmap.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mindmap.openSplit",
        "title": "Open Mindmap Beside",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "command": "mindmap.openSplit",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mindmap.openSplit",
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m",
        "when": "editorLangId == markdown"
      }
    ],
    "customEditors": [
      {
        "viewType": "mindmap.editor",
        "displayName": "Mindmap Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node esbuild.js --tests && node out/test/runTest.js",
    "test:webview": "node esbuild.js --tests && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.20.0",
    "fast-check": "^3.23.2",
    "markdown-it": "^14.3.3",
    "mind-elixir": "^4.6.2",
    "mocha": "^10.8.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
